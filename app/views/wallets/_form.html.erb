<%= form_with model: wallet do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>
  
  <div class="flex flex-col">
    <%= form.label :address %>
    <%= form.text_field :address, class: "w-100 border border-solid border-grey-300 rounded p-1" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
